{
  "name": "Follow the Line",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  // Mount the whole URT-Repo (so Git works), then open the follow-the-line folder inside it.
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces/URT-Repo,type=bind",
  "workspaceFolder": "/workspaces/URT-Repo/follow-the-line",
  "postStartCommand": "git config --global --add safe.directory /workspaces/URT-Repo",
  "forwardPorts": [8888],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"]
    }
  }
}
